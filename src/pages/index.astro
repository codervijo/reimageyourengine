---
// src/pages/index.astro — ported from genai/src/routes/index.tsx
import Layout from "../layouts/Layout.astro";
import { HomePage } from "../components/pages/HomePage";

const site = "https://reimageyourengine.com";
const title = "Engines Reimagined — Reimagine Your Engine";
const description = "Derek Hoyt’s engineering background in rotating equipment and fluid systems, with equipment troubleshooting and support implementing PHA recommendations.";
const ogDescription = "Derek Hoyt: design, manufacturing, and operability of rotating equipment and fluid systems, from manure weirs to reusable rocket engines.";
// Canonical MUST match the served URL incl. trailing slash (trailingSlash:
// 'always' in astro.config.mjs). A no-slash canonical 308-redirects and
// breaks indexing (CHECK_161).
const canonical = `${site}/`;
---
<Layout seo={false}>
  <Fragment slot="head">
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Reimagine Your Engine" />

    <!-- Twitter card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={ogDescription} />

    <!-- JSON-LD: Organization + WebSite + LocalBusiness (bracketed values
         are placeholders carried over from genai/ — fill before launch). -->
    <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://reimageyourengine.com/#organization",
      "name": "Reimagine Your Engine",
      "description": "Derek Hoyt — rotating equipment, fluid systems, equipment reliability, and process-safety support.",
      "url": "https://reimageyourengine.com/"
    },
    {
      "@type": "WebSite",
      "@id": "https://reimageyourengine.com/#website",
      "url": "https://reimageyourengine.com/",
      "name": "Reimagine Your Engine",
      "publisher": { "@id": "https://reimageyourengine.com/#organization" }
    },
    {
      "@type": ["LocalBusiness", "ProfessionalService"],
      "@id": "https://reimageyourengine.com/#business",
      "name": "Reimagine Your Engine",
      "description": "Derek Hoyt — rotating equipment, fluid systems, equipment reliability, and process-safety support.",
      "telephone": "[PHONE NUMBER]",
      "email": "[EMAIL ADDRESS]",
      "url": "https://reimageyourengine.com/",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "[STREET ADDRESS]",
        "addressLocality": "[CITY]",
        "addressRegion": "[STATE]",
        "postalCode": "[ZIP]",
        "addressCountry": "US"
      },
      "areaServed": "[SERVICE AREA]"
    }
  ]
}
    </script>
  </Fragment>
  <HomePage />
</Layout>
